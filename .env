# RIS KPI settings: run settings + the DB credential keys for db_push (values empty in git, filled in on the server only).
# Edit and run again (no reinstall needed). An environment variable of the same name wins over the value here.

# s3    = read the inputs from and write the outputs to the S3 locations below (EC2 runs: keep s3)
# local = input_data/ and output_data/ inside the repository (laptop testing without AWS access only)
RIS_KPI_STORAGE=s3

# --- S3 locations ---
# Input: DB tables exported by the DB export job (dlm_defect_case, udm_defect_reference, master_upc_project, ...)
S3_DB_TABLES_DIR=s3://dhms-new-stgae/NSV/DHMS/DIC_Staging/Latest
# Input: silver tables, <S3_SILVER_INPUT_DIR>/Zone=B/Phase=1/Cycle=1/UPC=N_01002_01001_GJ/...
S3_SILVER_INPUT_DIR=s3://dhms-new-stgae/DHMS/NSV/Silver
# Output: every table, in <S3_GOLD_OUTPUT_DIR>/year=YYYY/month=MM/day=DD/ and <S3_GOLD_OUTPUT_DIR>/Latest/
# (the newest copy is read back on the next run: a new folder = a fresh start). db_push reads <S3_GOLD_OUTPUT_DIR>/Latest/
S3_GOLD_OUTPUT_DIR=s3://dhms-new-stgae/DHMS/NSV/Gold

# True  = run only the surveys listed in UPC_LIST_FILE
# False = run every Zone / Phase / Cycle / UPC folder under the silver folder
CONSIDER_UPC_LIST=True

# Survey list: CSV with the columns upc, phase, cycle, zone (relative to the repository root, or an absolute path)
UPC_LIST_FILE=upc_to_run.csv

# ris_view_data and ris_trends_data rows with an empty upc_id / survey_id / survey_source_id (no DB match):
# True = dropped, False = kept with the empty ids (logged either way)
DROP_ROWS_WITHOUT_IDS=True

# survey_id comes from survey_data_map on upc + phase + cycle. When one upc + phase + cycle has several
# survey_schedule_ids:
# True  = look them up in wfm_survey_schedule (read from S3_DB_TABLES_DIR; id = survey_schedule_id, same upc) and take
#         the one with current_status 'Survey Final Approved', else 'Validation in Progress' (else left empty)
# False = survey_id left empty for that upc + phase + cycle
SURVEY_ID_FALLBACK=True

# --- DB credentials for db_push/push_to_db.py (empty in git: fill in on the server only, never commit the values) ---
# After filling them in on the server, run once:  git update-index --skip-worktree .env   (git then ignores the edit)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public